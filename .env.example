DATABASE_URL=postgresql://takumipay:takumipay-123@localhost:5432/takumipay
PORT=4000
VCGAMERS_SECRET=

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_TIME=90D
REFRESH_TOKEN_EXPIRATION_TIME=200D
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

NONCE_EXPIRE_TIME_MINUTES=5
SIWE_DOMAIN="com.cstralpt.takumipay"
SIWE_URI="takumipay://wallet-auth"
SIWE_STATEMENT="Sign in to TakumiPay Mobile App"

CHAIN_ID=1
MIN_CONFIRMATIONS=12

VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_REQUEST_TIMEOUT=5000

# Security & CORS
CORS_ORIGINS=http://localhost:3000,https://app.takumipay.xyz,takumipay://
CORS_CREDENTIALS=true
MAX_REQUEST_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BOOKING_RATE_LIMIT_WINDOW_MINUTES=15
BOOKING_RATE_LIMIT_MAX_REQUESTS=10

# Google OAuth
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com

# Email (Resend) — delivers the sign-in verification code.
#
# Sending is done from the `email.takumipay.xyz` subdomain, not the root
# domain. A subdomain keeps transactional-mail reputation separate from
# takumipay.xyz itself, so a bounce/complaint spike on sign-in codes can't
# poison delivery for the apex domain.
#
# The subdomain must be verified at https://resend.com/domains — that means
# publishing Resend's SPF, DKIM, and DMARC records on `email.takumipay.xyz`
# before any of this delivers. `onboarding@resend.dev` is test-only and must
# not ship to production.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=TakumiPay <noreply@email.takumipay.xyz>

# Lifetime of the Google sign-in verification code.
OTP_EXPIRE_MINUTES=10

# NATS (optional — pub/sub for cross-pod cache invalidation)
NATS_SERVERS=nats://your-nats-host:4222
NATS_USER=
NATS_PASS=

# TakumiPay signed-QR signing key (ES256 / P-256 PEM, PKCS#8 or SEC1).
# Multi-line PEM with literal \n escapes OR the full BEGIN/END block.
# This is the PRIVATE half of the EXPO_PUBLIC_TAKUMIPAY_QR_PUBKEY_JWK bundled in mobile.
# NEVER commit, NEVER mirror to takumi-agent-api, NEVER ship under any EXPO_PUBLIC_* prefix.
# Rotated via scripted key gen + EAS OTA (spec §4.4 final paragraph; ops task 50).
TAKUMIPAY_QR_PRIVATE_KEY_PEM=

# TakumiPay QR JWS `kid` (JOSE header key-id). Bumped in lockstep with the
# EXPO_PUBLIC_TAKUMIPAY_QR_PUBKEY_JWK rotation. Default: 2026-04-20.
TAKUMIPAY_QR_KID=2026-04-20

# NOTE: TAKUMIPAY_QR_EXP_DAYS has been removed. QRs no longer expire —
# revocation is handled server-side via merchant.isActive at intent-creation
# time. JWS signature proves authenticity; the server decides whether to
# honor the merchant.

# Circle Gateway x402 supported URL (spec §6.5, task 22).
# Backend fetches this at boot + every 12 h and caches under key `x402:supported`
# in Valkey (24 h TTL) + in-memory for hot-path EIP-712 domain lookups.
# Use the testnet URL for staging, the prod URL for mainnet.
#   testnet: https://gateway-api-testnet.circle.com/gateway/v1/x402/supported
#   prod:    https://gateway-api.circle.com/gateway/v1/x402/supported
CIRCLE_X402_SUPPORTED_URL=https://gateway-api-testnet.circle.com/gateway/v1/x402/supported

# Optional Circle Developer Console API key. When set, the settle proxy
# attaches `Authorization: Bearer ${CIRCLE_API_KEY}` to the request so the
# transfer shows up in the Console attestation history. NEVER commit a
# real key to source control — generate per-environment via `app.circle.com`.
#
# NOTE: The facilitator settle URL (previously `CIRCLE_GATEWAY_API` +
# hardcoded path for EVM, `CIRCLE_X402_SVM_FACILITATOR_URL` for SVM) is now
# stored per-chain in `Blockchain.x402FacilitatorUrl`. Configure via seed/SQL:
#   UPDATE "Blockchain"
#      SET "x402FacilitatorUrl" = 'https://gateway-api-testnet.circle.com/gateway/v1/x402/settle'
#    WHERE "chainSlug" = 'arc-testnet';
CIRCLE_API_KEY=

# Default payout provider for new merchants and pre-signup channel listing.
# Valid values: xendit | duitku | flip
DEFAULT_PAYOUT_PROVIDER=duitku

# Xendit disbursement / payout provider (task 29, spec §6.4).
# `XENDIT_API_BASE` points at Xendit's REST root — the `/v2/payouts` path
# is appended by `XenditPayoutProvider`. Keep the default unless you're
# routing through a corporate proxy.
XENDIT_API_BASE=https://api.xendit.co

# Xendit secret key — used as HTTP Basic username with an empty password
# (`Authorization: Basic base64(KEY:)`). Format `xnd_development_…` for
# sandbox, `xnd_production_…` for live. NEVER commit a real key, NEVER
# mirror to mobile, NEVER log (redaction is enforced in
# `XenditPayoutProvider`).
XENDIT_SECRET_KEY=

# Static `x-callback-token` issued by Xendit when the webhook URL is
# registered. Consumed by task 30 (`POST /webhooks/xendit`) for signature
# verification via `XenditPayoutProvider.verifyWebhookSignature`. NEVER
# commit a real value — rotate by re-registering the callback URL in the
# Xendit dashboard.
XENDIT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Duitku disbursement (Online Transfer: RTOL + e-wallet)
# Research ref: docs/duitku_payout_provider_research.md §2, §5
# ---------------------------------------------------------------------------
# Integer merchant id issued by Duitku after disbursement activation.
DUITKU_DISB_USER_ID=
# Registered merchant email. Also the second identifier in every signature.
DUITKU_DISB_EMAIL=
# Opaque shared secret (SHA256 HMAC material). Emailed by Duitku after
# activation. NEVER commit, NEVER log (redaction enforced in the adapter).
DUITKU_DISB_SECRET_KEY=
# API base. Sandbox for dev, `https://passport.duitku.com/webapi/api/disbursement`
# for prod. The adapter appends `/inquiry`, `/transfer`, `/inquirystatus`
# (and their sandbox variants) per §2.2 / §2.3.
DUITKU_DISB_API_BASE=https://sandbox.duitku.com/webapi/api/disbursement

# ---------------------------------------------------------------------------
# Flip Business disbursement (Money Transfer API v2)
# Spec ref: docs/flip_payout_provider_spec.md §2.1, §2.2, §4.8
# ---------------------------------------------------------------------------
# Secret key from Flip for Business dashboard. Used as HTTP Basic Auth
# username with empty password (`Authorization: Basic base64(KEY:)`).
# NEVER commit a real key, NEVER log (redaction enforced in the adapter).
FLIP_SECRET_KEY=
# Webhook validation token from Flip dashboard. Sent by Flip in callback
# bodies as the `token` field. Verified via constant-time comparison.
# NEVER commit a real value.
FLIP_VALIDATION_TOKEN=
# API base URL. Sandbox for dev, `https://bigflip.id/api/v2` for prod.
# The adapter appends `/disbursement`, `/general/balance`, etc.
FLIP_API_BASE=https://bigflip.id/big_sandbox_api/v2

# ---------------------------------------------------------------------------
# ERC-4337 bundler URLs (task 37 — `POST /v1/userop/submit`, spec §6.7, §10)
# ---------------------------------------------------------------------------
# Bundler URLs are NOT env-configured — they live in the `Blockchain.bundlerUrl`
# column (see `prisma/schema.prisma`), resolved per-chain by `UserOpService`
# with a short in-process cache. Ops seeds each supported chain via SQL:
#
#     UPDATE "Blockchain"
#        SET "bundlerUrl" = 'https://api.pimlico.io/v2/base/rpc?apikey=<KEY>'
#      WHERE "chainId"    = 8453;
#
# A NULL `bundlerUrl` is the allowlist signal: requests for that chainId are
# rejected 400 `CHAIN_NOT_SUPPORTED`. Mobile never sees these URLs — the
# adapter (task 35) signs UserOps locally and POSTs to `/v1/userop/submit`.
#
# The column currently carries the provider API key in the query string. The
# planned split (URL-clean-of-key in DB + key in a secrets manager, joined
# at request time with `Authorization: Bearer`) is tracked in
# `docs/security_review_needed.md §4`.

# ---------------------------------------------------------------------------
# Path B-SVM — Solana x402 facilitator (task 43, spec §5.2.1, §10, §12 Q7)
# ---------------------------------------------------------------------------
# PLATFORM_TREASURY_ADDRESS_SVM — platform-owned Solana keypair (base58 pubkey)
# that receives USDC-SPL as the `payTo` for every Solana Nanopay intent.
# Paired with SVM_SETTLER_PRIVATE_KEY (below — ops only, never committed, never
# mirrored to mobile under any EXPO_PUBLIC_* prefix). May be BLANK until M6 —
# the pay module tolerates absence and the SVM rail simply returns a typed
# 503 on create-intent until both envs are filled in. See spec §5.2.1 for
# the USDC ATA bootstrap runbook.
PLATFORM_TREASURY_ADDRESS_SVM=
SVM_SETTLER_PRIVATE_KEY=


# NOTE: CIRCLE_X402_SVM_FACILITATOR_URL has been removed. The SVM facilitator
# URL is now stored in `Blockchain.x402FacilitatorUrl` alongside EVM chains.
# Configure via seed/SQL:
#   UPDATE "Blockchain"
#      SET "x402FacilitatorUrl" = 'https://gateway-api-testnet.circle.com/gateway/v1/x402/settle'
#    WHERE "chainSlug" = 'solana-mainnet';

# ---------------------------------------------------------------------------
# Onchain Settlement Rail (task 18-32, spec §4.4, §4.7a, §4.8, §4.9, §8)
# ---------------------------------------------------------------------------
# Default settlement rail for new intents when the intent's `path` column is
# not explicitly set. Valid values: nanopay | takumipay
PAYMENT_SETTLEMENT_RAIL=takumipay
# Per-rail confirmation override for onchain settlement. When set, overrides
# the global MIN_CONFIRMATIONS for the onchain rail only. Leave blank to
# fall back to MIN_CONFIRMATIONS (default 12).
ONCHAIN_MIN_CONFIRMATIONS=
# 0x-prefixed 66-char EIP-712 signer key used to sign quote commitments for
# the TakumiWalletMerchant contract (EVM chains).
EVM_QUOTE_SIGNER_PRIVATE_KEY=
# JSON array of secret key bytes for the Solana backend quote signer
# (Keypair.fromSecretKey). Signs quote commitments for the takumi_pay
# Solana program.
SOLANA_QUOTE_SIGNER_PRIVATE_KEY=
# StrKey S... secret seed for the Stellar backend quote signer
# (Keypair.fromSecret). Signs MerchantQuote commitments verified by the
# Soroban takumi_pay contract's process_merchant_payment via ed25519_verify.
# Must correspond to the same key passed as `backend_signer` at contract
# `initialize`/`rotate_backend_signer` time (see
# ../contract/stellar/deployments/<network>/vN.json).
STELLAR_QUOTE_SIGNER_PRIVATE_KEY=
# TTL in seconds for direct_arc quotes. Default 900 (15 min). The intent's
# expiresAt is set to now() + this value at quote time.
QUOTE_TTL_DIRECT_ARC_SECONDS=900
# EIP-712 domain name used by the TakumiWalletMerchant contract's
# processMerchantPayment signature verification.
QUOTE_SIGNATURE_DOMAIN_NAME=TakumiPay
# EIP-712 domain version — must match the contract's constructor arg.
QUOTE_SIGNATURE_DOMAIN_VERSION=1

# ---------------------------------------------------------------------------
# DeFi Strategies Phase 1
# ---------------------------------------------------------------------------
# API keys
ZERION_API_KEY=
DEBANK_API_KEY=
# DeFiLlama key is optional — public endpoints work without one.
DEFILLAMA_API_KEY=
# LI.FI key is optional — public endpoints work without one (rate-limited).
LIFI_API_KEY=
# LI.FI integrator name (attribution string, NOT a secret). Defaults to
# "takumipay" when unset; set to your prod app name when you ship.
LIFI_INTEGRATOR=takumipay
# Tower Exchange (Arc DEX aggregator) — same-chain swaps on Arc through
# `/bridge/quote` (src/bridge/providers/tower.adapter.ts). Server-to-server
# key from devs.tower.exchange, NEVER an EXPO_PUBLIC_* var. Unset = Arc
# swaps report "no route". TOWER_EXECUTORS_<chainId> (comma separated)
# overrides the allowlisted swap executor if Tower redeploys it.
TOWER_API_KEY=
# TOWER_API_URL=https://www.tower.exchange/api/public
# TOWER_EXECUTORS_5042=0xeB8940752Fa12944d3b2D736d51fA36E4dA32BC8

# ── Swap routing policy (feature flags, no release needed) ──────────────
# Same-chain swaps touching these tokens use ONLY the preferred providers,
# in order, each later one the fallback.
#   Now (co-marketing): Tower first, LI.FI if Tower cannot route.
#   After the co-marketing: SWAP_PREFERRED_PROVIDERS=lifi
#                           DISABLED_ROUTE_PROVIDERS=tower
# An empty SWAP_PREFERRED_SYMBOLS turns the policy off.
# SWAP_PREFERRED_SYMBOLS=USDC,EURC,cirBTC
# SWAP_PREFERRED_PROVIDERS=tower,lifi
# Providers reachable ONLY for the preferred tokens above (Tower is the
# co-marketing lane, not a general router). Every other token is open to
# whatever the providers can swap (LI.FI). Clear it to let Tower compete.
# ROUTE_POLICY_ONLY_PROVIDERS=tower
# Providers taken out of routing entirely (retired, or killed during an
# incident). Comma separated adapter keys: tower, lifi, cctp, circle-cctp...
# DISABLED_ROUTE_PROVIDERS=
# Circle CCTP. USDC/EURC quotes go through Arc App Kit (no key needed,
# src/bridge/providers/circle/). Routes touching Stellar are raw CCTP and
# mainnet stays OFF until the testnet dry-run in bridge spec §10.6 passes;
# set to exactly "true" to open it. The Soroban RPC URLs serve the
# read-only "did the Stellar mint happen" check.
# CCTP_STELLAR_MAINNET_ENABLED=false
# STELLAR_SOROBAN_RPC_URL_PUBNET=https://mainnet.sorobanrpc.com
# STELLAR_SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
# Alchemy Prices API key (api.g.alchemy.com/prices/v1) — the USD spot-price
# source for DeFi position valuation (`POST /strategies/asset-prices`,
# strategies/external/alchemy-prices.client.ts). Server-side only, same
# posture as the RPC provider key in rpc-proxy — NEVER an EXPO_PUBLIC_* var.
# Missing key = every price resolves to null (position $ value shows as
# unavailable rather than the app crashing).
# Alchemy API key — one key covers every Alchemy product we call directly
# from this service: the Prices API (strategies/external/alchemy-prices.client.ts)
# and the Token API used for token symbol/icon lookups
# (tokens/alchemy-token-metadata.client.ts). Chain RPC does NOT use this key;
# that goes through rpc-proxy, which owns its own upstream credentials.
# Server-side only — never reaches the mobile bundle.
ALCHEMY_API_KEY=

# Deprecated alias for ALCHEMY_API_KEY, still read as a fallback so a
# code-before-env deploy keeps working. Remove once every environment is
# renamed.
ALCHEMY_PRICES_API_KEY=

# Worker toggles & budgets
DEFI_WORKERS_ENABLED=true
DEFI_STABLECOIN_DEPEG_THRESHOLD_BPS=50
DEFI_ZERION_DAILY_BUDGET_REQUESTS=1000
DEFI_DEBANK_DAILY_BUDGET_CENTS=500
DEFI_ALCHEMY_PRICES_DAILY_BUDGET_REQUESTS=5000
# Days between auto-compound nudges per position (spec §21.3). The
# watcher cron fires daily, but its per-bucket dedup means each user
# only sees one push per window. Default 7.
DEFI_AUTO_COMPOUND_INTERVAL_DAYS=7

# --- EVM protocol expansion (docs/defi-evm-protocol-expansion-spec.md §8.6) --
# Tier gates for the EVM DeFi families. Each one must be enabled on BOTH sides:
# the mobile twins are EXPO_PUBLIC_FF_DEFI_EVM_TIER1..4. A family live on only
# one side would badge "Deposit in-app" for a target nothing can execute.
#
# DEFAULT OFF, deliberately. §11.3 forbids registering a family before its
# Layer-1 validator, Layer-4 decode assertion and Layer-5 pause check are
# fork-tested, and §12 Q7 requires security sign-off on every pinned address in
# src/strategies/targets/address-book/. Enabling a tier is a reviewed act.
# ⚠️ BEFORE FLIPPING THESE: mobile-app/docs/runbooks/add-defi-pool-resolver.md §12.
#    Off is a review gate, not unfinished work. Tiers 1-3 are fork-tested; what
#    is still missing for production is SECURITY SIGN-OFF on the pinned address
#    book (§12 Q7). Restart the API after changing these — a resolver that was
#    not registered at boot never writes a depositTarget.
FEATURE_DEFI_EVM_TIER1=false   # Family A (ERC-4626) + Family B (Aave forks) — resolvers only
FEATURE_DEFI_EVM_TIER2=false   # Comet, cToken forks, Morpho Blue, Curve LP
FEATURE_DEFI_EVM_TIER3=false   # Pendle router-call, Solidly LP, LSTs
FEATURE_DEFI_EVM_TIER4=false   # ERC-7540 async — no resolver until §7 ships

# Per-family sub-flag under an enabled tier (default ON within one), so a single
# family can be dark-launched: FEATURE_DEFI_EVM_FAMILY_<FAMILY_UPPERCASED>.
#   FEATURE_DEFI_EVM_FAMILY_CURVE=false

# Layer-3 kill-switch (§11). Distinct from the rollout flags: ops flips this to
# stop an ALREADY-live family instantly on an exploit disclosure, with no
# redeploy. Comma-separated resolver families and/or DepositTarget kinds. The
# mobile twin is EXPO_PUBLIC_DEFI_FAMILY_KILL_SWITCH.
#   DEFI_FAMILY_KILL_SWITCH=compound-v3,curve
DEFI_FAMILY_KILL_SWITCH=

# Per-chain DeFi enablement, separate from "chain is supported" (§11 Layer 3).
# Empty = every chain in the directory. Comma-separated chain ids.
#   DEFI_ENABLED_CHAIN_IDS=1,8453,42161
DEFI_ENABLED_CHAIN_IDS=

# Chain-name aliases for external catalogs whose naming differs from the
# Blockchain rows (e.g. DeFiLlama says "BSC" where the row is "BNB Smart
# Chain"). Chain SUPPORT itself is data — the Blockchain table — so this is the
# only chain knowledge in config, and a name can never become a tx.to.
# JSON object: external name -> chainId (number) or chainSlug (string).
#   STRATEGIES_CHAIN_ALIASES={"bsc":56,"op mainnet":"optimism"}
STRATEGIES_CHAIN_ALIASES=

# --- Blockchain RPC (rpc-proxy) ---------------------------------------------
# Every chain's RPC goes through rpc-proxy, which owns the upstream provider
# credentials (Alchemy et al.) and fails over to public endpoints. The
# Blockchain.rpcUrl column stores only a route ("/evm/1", "/solana/mainnet"),
# so the origin below is what turns it into a callable URL — rotating the
# domain or the key is a redeploy, never a re-seed, and no provider key ever
# lands in the database or in the public GET /blockchains response.
#
# REQUIRED — resolveRpcEndpoint() throws at startup if a route is stored and
# this is missing.
RPC_PROXY_URL=http://localhost:8787
# Must equal PROXY_API_KEY — the rpc-proxy *server-tier* data-plane key, not
# PROXY_ADMIN_KEY (api never calls /admin/*). Leave empty for local dev / a
# private network; rpc-proxy disables auth when its own key is unset.
#
# TREAT AS A SECRET. It used to be shared with the mobile bundle through
# EXPO_PUBLIC_RPC_PROXY_API_KEY, which made it extractable from any APK and
# impossible to rotate. Clients mint their own per-device token now, so this
# value is server-side only — see the tier table in rpc-proxy/README.md.
RPC_PROXY_API_KEY=

# Base URLs (REQUIRED — services fail loudly at startup if missing).
# Override these only if you proxy these endpoints or use a non-default host.
DEFILLAMA_YIELDS_URL=https://yields.llama.fi
DEFILLAMA_API_URL=https://api.llama.fi
# Only required when DEFILLAMA_API_KEY is also set (free tier ignores this).
DEFILLAMA_PRO_URL=https://pro-api.llama.fi
LIFI_API_URL=https://li.quest/v1
ZERION_API_URL=https://api.zerion.io/v1
DEBANK_API_URL=https://api.cloud.debank.com/v1

# Operational tuning — leave unset to use the defaults shown.
# DeFiLlama: pool-poll cache TTL (seconds; should match the cron tick).
# DEFILLAMA_POOLS_CACHE_TTL_SEC=1800
# DeFiLlama: per-protocol metadata cache TTL (seconds; metadata is slow-moving).
# DEFILLAMA_PROTOCOL_CACHE_TTL_SEC=21600
# DeFiLlama: HTTP request timeout (ms) for every DeFiLlama call.
# DEFILLAMA_REQUEST_TIMEOUT_MS=20000
# DeFiLlama: skip pools below this TVL (USD) when filtering /pools.
# DEFILLAMA_MIN_TVL_USD=5000000
# Scoring worker: how many pools are scored in PARALLEL (default 8).
# Lower this on a slow or contended uplink — the symptom is
# UND_ERR_CONNECT_TIMEOUT against api.llama.fi in the worker logs while the same
# host answers fine from a bare `node -e "fetch(...)"`. Fewer parallel jobs
# finish more pools per tick than more jobs that all time out.
# SCORE_CONCURRENCY=3
# Scoring worker: how many cached-but-unfed pools get re-resolved per tick.
# DEFILLAMA_RERESOLVE_BATCH=150
# DeFiLlama: cap on how many pools are scored per cron tick.
# DEFILLAMA_MAX_POOLS=100
# LI.FI: HTTP request timeout (ms).
# LIFI_REQUEST_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Push notifications (Expo Push)
# ---------------------------------------------------------------------------
# Powers the auto-compound watcher push (defi-strategies-spec.md §21.3)
# and the UMKM USDC payout receipt push (umkm-usdc-payout-spec.md §6.3).
# Leave EXPO_ACCESS_TOKEN blank to use the free anonymous relay
# (recommended for MVP — unlimited deliveries, rate-limited per source IP).
# Set an access token (https://expo.dev → account → access tokens) to
# enable enhanced-security mode and bypass per-IP rate limits.
EXPO_ACCESS_TOKEN=

# Public origin of THIS api, as a phone reaches it (no trailing slash).
# Used to build absolute URLs we put inside push payloads — today the
# transfer push's large icon, `${PUBLIC_API_URL}/tokens/:id/icon.png`
# (src/tokens/token-icon.service.ts), which serves every Token.logoUrl as a
# device-decodable PNG regardless of what the catalogue row points at (SVG,
# hot-link-protected CDN, ...). Blank = the push embeds the raw logoUrl, and
# SVG / UA-gated logos render with no icon on Android. Local dev: your LAN
# IP, the same value mobile's EXPO_PUBLIC_API_URL uses.
PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# DeFi target resolution — data sources and verification
# ---------------------------------------------------------------------------
# DeFiLlama moved /poolsOld behind a paid plan (HTTP 402). It is the generic
# fallback source for candidate vault addresses; the protocol-specific on-chain
# sources (Euler, Fluid, Curve, Solidly) work without it. Set a pro key to
# restore the fallback for the families that have no on-chain registry yet.
# DEFILLAMA_PRO_API_KEY=
#
# Per-chain RPC override for target validation. Point at anvil for a fork run,
# or at a direct endpoint during an rpc-proxy incident. Normally unset: the
# endpoint comes from the Blockchain row via rpc-proxy.
# STRATEGIES_RPC_URL_1=
#
# Opt-in drift checks (see docs/runbooks/add-defi-pool-resolver.md §11.5).
# Run nightly, not in CI — a failure means "a family has gone dark", not
# "the build is broken".
#   DRIFT_CHECKS=1         both address-book and external-API drift
#   ADDRESS_BOOK_DRIFT=1   address book only

# ---------------------------------------------------------------------------
# Wallet-activity pushes (Zerion transaction webhooks) — src/wallet-activity/
# ---------------------------------------------------------------------------
# "You received 2.09 AUSD" / "You swapped 86 MON for 2.09 AUSD" / "Token
# approval" / "Transaction failed" for EVERY wallet the app holds, on every
# chain in the Blockchain registry that Zerion indexes — including activity
# the app itself never sees (transfers from other wallets, swaps on third-
# party dapps). Uses the same ZERION_API_KEY as the portfolio screens; the
# subscription control-plane calls are not counted against
# DEFI_ZERION_DAILY_BUDGET_REQUESTS.
#
# Callback URL: defaults to `${PUBLIC_API_URL}/webhooks/zerion/transactions`.
# Override only when the public host differs from PUBLIC_API_URL (a separate
# ingress for webhooks, an ngrok tunnel in dev).
#
# ONE-TIME DASHBOARD STEP: Zerion only delivers to whitelisted hosts. In
# https://dashboard.zerion.io click Support and ask for the callback host to
# be whitelisted. Until then callbacks are silently not delivered (the
# subscription itself is created automatically by the api on boot).
ZERION_WEBHOOK_CALLBACK_URL=
# Blank = on when the callback URL is https (production), off for an http
# LAN URL (a dev box must not register its wallets on the shared Zerion
# account). "true" forces it on for an http callback; "false" turns it off.
ZERION_WEBHOOKS_ENABLED=
# Every callback is RSA-verified against Zerion's certificate; "false" only
# for local testing with hand-crafted payloads.
ZERION_WEBHOOK_VALIDATE_SIGNATURES=true

# ── WalletConnect push server (deep-link spec §7.5) ─────────────────────
# This API implements the WalletConnect push-server spec under
# /walletconnect/push. Set the project's Dashboard "Push URL" to
# https://<public api host>/walletconnect/push. Relay deliveries are
# Ed25519-signed; the relay key is fetched from
# https://relay.walletconnect.com/public-key and cached. Override only if
# that fetch is blocked from the server; set VALIDATE to "false" only for
# local testing.
WALLETCONNECT_RELAY_PUBLIC_KEY=
WALLETCONNECT_PUSH_VALIDATE_SIGNATURES=true

# --- Fulfilment leg (src/fulfilment) ---------------------------------------
# Vendor status-code mappings live in each adapter (provider-agnostic core);
# nothing vendor-specific is configured here.
# Points refunds above this are held for an admin (1 point = Rp 1).
POINTS_REFUND_AUTO_CAP=2000000
# More than this many auto refunds for one product in the window trips the
# per-brand breaker (a vendor outage, not N unlucky buyers): held, not credited.
POINTS_REFUND_BREAKER_MAX=20
POINTS_REFUND_BREAKER_WINDOW_SEC=600

# ── Onramp (Arc App Kit) ─ mobile-app docs/onramp-app-kit-spec.md §5 ──
# Buy is ON by default (ONRAMP_ENABLED=false switches it off). Checkout
# runs only once a key, a supported chain and ONRAMP_HOSTED_PAGE_URL are set
# (production also needs ONRAMP_REFERRER_DOMAIN); until then debug builds
# show a preview.
# Separate sandbox and production keys, from Circle Console, server only.
ONRAMP_ENABLED=true
ONRAMP_ENVIRONMENT=sandbox
ONRAMP_API_KEY=
# Bare hostname of the page that embeds the widget (KYB web_url). Enforced
# in production for card / Apple Pay / Google Pay.
ONRAMP_REFERRER_DOMAIN=onramp.takumipay.xyz
# The checkout page that frames the widget: the takumipay-onramp project,
# versioned path, e.g. https://onramp.takumipay.xyz/v1/ . Required: the
# widget only accepts an https (or localhost) frame parent, so the app
# cannot host it itself. Local dev, sandbox only: run `npm run dev` in
# ../onramp, `adb reverse tcp:5180 tcp:5180`, and use
# http://localhost:5180/v1/
ONRAMP_HOSTED_PAGE_URL=
# Receivable chains. Default: Arc Testnet in sandbox, none in production
# (Arc mainnet availability is unconfirmed, spec Q10).
# ONRAMP_SUPPORT=[{"chainKey":"eip155:5042002","widgetChain":"arc","tokens":["USDC","EURC"]}]
# Optional overrides: ONRAMP_API_BASE_URL, ONRAMP_WIDGET_BASE_URL,
# ONRAMP_EXTERNAL_LINK_HOSTS (csv), ONRAMP_SESSION_RATE_LIMIT (per 10 min).

# ── Add funds token picker (mobile Swap / Bridge tabs) ──
# Optional: limit a chain to a fixed token set (vouched addresses only).
# Unset = every chain offers whatever a provider validates. Example:
# ROUTE_TOKEN_SYMBOLS_BY_CHAIN=eip155:5042=USDC,EURC,cirBTC
