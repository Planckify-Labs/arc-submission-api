{
  "name": "takumipay-api",
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --maxWorkers=2",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --maxWorkers=2",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --maxWorkers=2",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:reset": "docker compose -f docker-compose.prod.yml down -v && docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "db:setup": "./scripts/setup-db.sh",
    "db:setup:prod": "./scripts/setup-db-prod.sh",
    "pushNotif:test": "ts-node --transpile-only scripts/push-notif-test.ts",
    "backfill:canonical-address": "ts-node --transpile-only -r tsconfig-paths/register src/scripts/backfill-canonical-wallet-address.ts",
    "backfill:delivery": "ts-node --transpile-only -r tsconfig-paths/register src/scripts/backfill-delivery.ts",
    "defi:dry-run": "node --env-file-if-exists=.env -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/resolve-targets-dry-run.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-solana": "1.7.3",
    "@circle-fin/adapter-viem-v2": "1.18.0",
    "@circle-fin/app-kit": "1.15.3",
    "@coral-xyz/anchor": "^0.32.1",
    "@lifi/sdk": "^3.16.3",
    "@mysten/sui": "^2.16.0",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@solana/addresses": "^2.3.0",
    "@solana/keys": "^2.3.0",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-base": "^15.0.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "@valkey/valkey-glide": "^2.0.1",
    "argon2": "^0.43.1",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "expo-server-sdk": "^6.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "nats": "^2.29.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "siwe": "^3.0.0",
    "swagger-ui-express": "^5.0.1",
    "tweetnacl": "^1.0.3",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "setupFiles": [
      "<rootDir>/config/jest-setup.ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "node_modules/@noble/.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.jest.json",
          "isolatedModules": true
        }
      ],
      "^(?!.*node_modules).+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!@noble\\+[a-z0-9-]+@)"
    ],
    "moduleNameMapper": {
      "^@generated/prisma$": "<rootDir>/generated/prisma/client",
      "^@generated/(.*)$": "<rootDir>/generated/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
