// TimescaleDB Hypertable - optimized for high-volume point ledger
// Composite PK required for hypertable partitioning on createdAt
// Note: No FK relation to PointRedemption — TimescaleDB hypertables cannot be
// the target of FK constraints (chunks live in _timescaledb_internal).
// Referential integrity is enforced at the application level.
model PointTransaction {
  id            String               @default(ulid())
  userId        String
  type          PointTransactionType
  amount        BigInt
  balanceBefore BigInt
  balanceAfter  BigInt

  // Deposit fields (populated for DEPOSIT type)
  // Note: refId/txHash are not @unique — TimescaleDB hypertables disallow unique
  // indexes without the partitioning column. Uniqueness enforced at app level.
  refId           String?
  txHash          String?
  tokenId         String?
  blockchainId    String?
  contractAddress String?
  // On-chain depositor address (the account that signed/paid the deposit).
  // Stored so the verifier checks the *actual* payer rather than the user's
  // single primary `walletAddress` — required for non-EVM chains (e.g.
  // Stellar), where the on-chain payer is a per-chain address the user has
  // linked to their account (WalletAccountLink) rather than their primary.
  walletAddress   String?
  tokenAmount     Decimal? @db.Decimal(36, 18)
  pointRate       Decimal? @db.Decimal(18, 8)

  // Redemption fields (populated for SPEND/REFUND type)
  referenceType String?
  referenceId   String?

  status    PointTransactionStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime               @default(now())

  user       User        @relation(fields: [userId], references: [id])
  token      Token?      @relation(fields: [tokenId], references: [id])
  blockchain Blockchain? @relation(fields: [blockchainId], references: [id])

  @@id([id, createdAt])
  @@unique([id, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([txHash])
  @@index([refId])
}

model PointPriceConfig {
  id        String   @id @default(ulid())
  baseRate  Decimal  @db.Decimal(18, 8)
  currency  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([currency, isActive])
  @@index([isActive, createdAt(sort: Desc)])
}

enum PointTransactionType {
  DEPOSIT
  SPEND
  REFUND
  BONUS
  /// Ops correction — today only the reversal of a fulfilment refund whose
  /// order turned out to be delivered after all (negative amount).
  ADJUSTMENT
}

/// Whether the vendor actually handed the product over. Independent of the
/// money leg (`PurchaseStatus` / `RedemptionStatus`), which only says the
/// payment cleared and the vendor accepted the order.
enum FulfilmentStatus {
  /// Paid; vendor order not placed yet.
  QUEUED
  /// Vendor accepted (`trx_code`); outcome pending — the poller owns it.
  SUBMITTED
  /// Still pending past the variant's SLA. One push, then keep polling.
  DELAYED
  /// Vendor reported terminal success; `delivery` is populated.
  DELIVERED
  /// Vendor reported terminal failure; a refund is created or held.
  FAILED
  /// Outcome unknown (timeouts, lost responses, >24h pending). Ops decides.
  NEEDS_RECONCILE
  /// Points credited back.
  REFUNDED
}

enum DeliveryType {
  /// A code the buyer redeems somewhere else (Steam, Google Play, PLN token).
  VOUCHER_CODE
  /// Credited straight to the account/number in `customerInfo`.
  DIRECT_TOPUP
  /// A bill settled on the buyer's behalf; the "delivery" is the receipt.
  BILL_PAYMENT
  /// The VENDOR emails the product to an address in `customerInfo`.
  EMAIL
}

enum FulfilmentRefundStatus {
  /// Held for an admin: over the auto cap, the brand breaker tripped, or
  /// the amount could not be derived safely.
  PENDING_REVIEW
  COMPLETED
  REJECTED
  /// Clawed back — the order was delivered after the refund.
  REVERSED
}

enum PointTransactionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
}

// Note: pointTransactionId/pointTransactionCreatedAt reference the PointTransaction
// hypertable but have no DB-level FK — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model PointRedemption {
  id                        String           @id @default(ulid())
  userId                    String
  pointTransactionId        String
  pointTransactionCreatedAt DateTime
  productVariantId          String
  productPriceId            String
  customerInfo              Json?
  status                    RedemptionStatus @default(PENDING)
  pointsSpent               BigInt
  vendorResponse            Json?
  vendorRefId               String?
  metadata                  Json?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  // ── Fulfilment leg — same columns as Purchase, see there.
  fulfilmentStatus       FulfilmentStatus  @default(QUEUED)
  fulfilmentError        String?
  delivery               Json?
  deliveryRaw            String?
  expectedBy             DateTime?
  fulfilledAt            DateTime?
  vendorLastCheckedAt    DateTime?
  vendorCheckCount       Int               @default(0)
  deliveredAfterRefundAt DateTime?
  refund                 FulfilmentRefund?

  user           User           @relation(fields: [userId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  productPrice   ProductPrice   @relation(fields: [productPriceId], references: [id])

  @@unique([pointTransactionId, pointTransactionCreatedAt])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([fulfilmentStatus, updatedAt])
}

enum RedemptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model FlashSale {
  id                 String   @id @default(ulid())
