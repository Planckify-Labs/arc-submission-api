// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  SUBCATEGORY
  MAINCATEGORY
}

model Category {
  id             String           @id @default(ulid())
  name           String           @unique
  description    String?
  imageUrl       String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Product        Product[]
  categoryType   CategoryType
  ProductVariant ProductVariant[]
}

model Product {
  id          String              @id @default(ulid())
  name        String
  description String?
  imageUrl    String?
  code        String              @unique
  category    Category            @relation(fields: [categoryId], references: [id])
  categoryId  String
  isActive    Boolean             @default(true)
  isVoucher   Boolean             @default(false)
  /// How the vendor hands the product over. Null = derive from `isVoucher`
  /// (see `resolveDeliveryType`). Drives the delivery card on mobile and
  /// which parser tier runs on `voucher_code`.
  deliveryType    DeliveryType?
  /// Ops-editable positional parser for this product's `voucher_code`
  /// (`VoucherTemplate` in src/delivery). Lets a new brand's format be
  /// handled without a deploy.
  voucherTemplate Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  variants    ProductVariant[]
  inputFields ProductInputField[]

  @@index([code])
}

enum InputFieldType {
  TEXT
  NUMBER
  EMAIL
  OPTION
  DATE
}

model ProductInputField {
  id        String   @id @default(ulid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  forms     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id               String            @id @default(ulid())
  name             String
  description      String?
  variantCode      String            @unique
  product          Product           @relation(fields: [productId], references: [id])
  productId        String
  isActive         Boolean           @default(true)
  /// Vendor-declared delivery SLA in seconds (VCGamers `sla`; 0/null = unknown).
  slaSeconds       Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ProductPrice     ProductPrice[]
  Purchase         Purchase[]
  BookingOrder     BookingOrder[]
  pointRedemptions PointRedemption[]
  flashSales       FlashSale[]
  subCategory      Category?         @relation(fields: [subCategoryId], references: [id])
  subCategoryId    String?

  @@index([variantCode])
}

model Vendor {
  id           String         @id @default(ulid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  VendorAPI    VendorAPI[]
  ProductPrice ProductPrice[]
}

model User {
  id                String               @id @default(ulid())
  // Stored canonical per-chain (checksummed EVM / verbatim Solana+Stellar) via
  // canonicalizeWalletAddress, so this @unique is itself the case-insensitive
  // dedup key. Replaced the former walletAddressLower fold column.
  walletAddress     String?              @unique
  email             String?              @unique
  username          String?              @unique
  password          String?
  name              String?
  profileImage      String?
  authProvider      AuthProvider
  socialId          String?
  role              UserRole             @default(USER)
  status            UserStatus           @default(ACTIVE)
  permissions       Json?
  lastLoginAt       DateTime?
  loginAttempts     Int                  @default(0)
  lockedUntil       DateTime?
  transactions      TransactionHistory[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  Region            Region?              @relation(fields: [regionId], references: [id])
  regionId          String?
  ApiKey            ApiKey[]
  auditLogs         AdminAuditLog[]
  dappFavorites     UserDappFavorite[]
  addressBook       AddressBook[]
  pointBalance      PointBalance?
  pointTransactions PointTransaction[]
  pointRedemptions  PointRedemption[]
  fulfilmentRefunds FulfilmentRefund[]
  nftAssets         NftAsset[]

  // UMKM USDC payout rails (§6.6)
  merchant              Merchant?
  paymentIntentsAsPayer PaymentIntent[]  @relation("PaymentIntentPayer")
  gatewayDeposits       GatewayDeposit[]

  devicePushTokens DevicePushToken[]
  notificationPreference NotificationPreference?

  // Wallets this (social) account has set up on some device. Lets a
  // returning user on a new device be told "we found your wallet" even
  // when there is no local storage and no Drive backup.
  walletLinks WalletAccountLink[]

  @@unique([authProvider, socialId])
  @@index([role])
  @@index([status])
  @@index([email])
  @@index([username])
}

/// Associates a social (Google) account with a wallet address it has used.
///
/// This is a *hint for recovery UX only* — it never stores key material and
/// TakumiPay remains non-custodial (seed lives on-device / in the user's own
/// Drive; see docs/encrypted-seed-backup-spec.md).
///
/// It is a separate table on purpose: `User.walletAddress` is `@unique` and is
/// already held by the wallet's own SIWE user row, so the same address cannot
/// also be written onto the Google user row. The link lets us answer "does
/// this account have a wallet?" without that collision, and supports one
/// account owning several wallets.
model WalletAccountLink {
  id            String   @id @default(ulid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  walletAddress String
  createdAt     DateTime @default(now())

  @@unique([userId, walletAddress])
  @@index([userId])
}

/// One row per device install. The Expo push token is the upsert anchor
/// (rotates on reinstall). failCount tracks consecutive Expo delivery
/// failures so a receipt-checking job can prune dead tokens at threshold.
model DevicePushToken {
  id           String    @id @default(cuid())
  token        String    @unique
  /// Nullable — devices can register before the user authenticates.
  /// Populated once a JWT is presented (see PushController); wallet
  /// targeting via WalletPushSubscription does not depend on this.
  userId       String?
  platform     String
  lastPushedAt DateTime?
  failCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions WalletPushSubscription[]

  @@index([userId])
}

/// WalletConnect push-server registration (specs/servers/push): the relay
/// client id of a wallet install, mapped to the device's Expo push token.
/// WalletConnect calls this API's push endpoints (the project's Dashboard
/// "Push URL") when a session request arrives for a client whose relay
/// socket is closed; we look the token up here and deliver through Expo.
model WalletConnectPushClient {
  clientId  String   @id
  token     String
  /// "fcm" | "apns" | "apns-sandbox" | "noop" (informational; delivery is Expo).
  type      String
  alwaysRaw Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
}

/// Links a device to a wallet address it should receive notifications for.
/// walletAddress is a plain string — any chain format, no namespace lock-in.
/// The replace-on-register strategy keeps this table authoritative from the
/// last successful POST /users/me/push-token call.
model WalletPushSubscription {
  id            String   @id @default(cuid())
  deviceTokenId String
  walletAddress String
  createdAt     DateTime @default(now())

  deviceToken DevicePushToken @relation(fields: [deviceTokenId], references: [id], onDelete: Cascade)

  @@unique([deviceTokenId, walletAddress])
  @@index([walletAddress])
}

/// Push-notification outbox + audit log. One row per notification a caller
/// asked for (not per device). The row is written FIRST — inside the
/// caller's own DB transaction when it has one (transfer history, etc.) — and
/// a `push-dispatch` job keyed by its id does the actual Expo send, so a
/// process restart, a Redis blip or an Expo outage between "we decided to
/// notify" and "Expo accepted it" can never silently drop a push: the
/// `PushOutboxSweeper` re-enqueues anything left in `queued`/`sending`.
///
/// This also answers "did we attempt to notify this user/wallet, to how
/// many devices, and what happened?" — including `no_device`, which is the
/// single most common reason a recipient never sees a transfer push.
model NotificationLog {
  id             String   @id @default(cuid())
  userId         String?
  walletAddress  String?
  title          String
  body           String
  data           Json?
  source         String
  /// Android channel id / rich-content image, kept so the dispatch worker
  /// (and the sweeper) can rebuild the exact Expo message from the row.
  channelId      String?
  imageUrl       String?
  /// Devices resolved for the target when the row was staged (audit).
  recipientCount Int
  targetDeviceIds  String[] @default([])
  /// Devices still waiting for an "ok" Expo ticket. Each attempt sends
  /// only to these, so a retry never double-sends a device Expo already
  /// accepted. Empty once every device is accepted / pruned / rejected.
  pendingDeviceIds String[] @default([])
  /// Worker attempts so far (inline fallback counts too).
  attempts       Int      @default(0)
  lastError      String?
  /// Drop rather than send after this — e.g. a WalletConnect "approval
  /// needed" push is useless once the request itself has expired.
  expiresAt      DateTime?
  /// When the row was staged (kept as `sentAt` for compatibility).
  sentAt         DateTime @default(now())
  /// First moment Expo accepted at least one ticket for this row.
  dispatchedAt   DateTime?
  updatedAt      DateTime @default(now()) @updatedAt

  // Lifecycle (`PushDeliveryStatus` in push.service.ts):
  //   queued → sending → pending → delivered | undelivered | unregistered
  //   plus the terminal short-cuts no_device | failed | expired.
  // "pending" means Expo accepted the tickets; the delayed receipt check
  // (PushReceiptProcessor) is what turns it into a real delivery verdict —
  // an "ok" ticket only says Expo took the request, not that the OS showed it.
  deliveryStatus    String    @default("queued")
  expoTicketIds     String[]  @default([])
  deliveryCheckedAt DateTime?

  /// Notification centre fields (see src/push/notification-categories.ts).
  /// `category` drives per-user mute preferences and the inbox filter;
  /// `dedupeKey` makes two producers of the same event (the sender's app
  /// recording a transfer, and the Zerion webhook seeing it on-chain) a
  /// single notification — the second insert hits the unique index;
  /// `readAt` is the inbox read marker.
  category  String?
  dedupeKey String?   @unique
  readAt    DateTime?

  @@index([userId])
  @@index([walletAddress])
  @@index([sentAt])
  @@index([deliveryStatus])
  @@index([deliveryStatus, updatedAt])
  @@index([userId, sentAt(sort: Desc)])
  @@index([walletAddress, sentAt(sort: Desc)])
}

/// Per-user notification settings. One row per user, created lazily on the
/// first PATCH — absent row = every default (see DEFAULT_CATEGORY_ENABLED
/// in src/push/notification-categories.ts). `categories` holds only the
/// explicit overrides ({ "wallet_activity": false, "portfolio_digest": true }),
/// so a new category added later is governed by its code default, not by
/// whatever was persisted before it existed.
model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories    Json     @default("{}")
  /// Hour (UTC, 0-23) the daily portfolio digest is sent, when enabled.
  /// Default 02:00 UTC = 09:00 WIB.
  digestHourUtc Int      @default(2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Blockchain {
  id                String             @id @default(ulid())
  name              String             @unique
  chainId           Int?               @unique
  chainSlug         String?            @unique
  // An rpc-proxy route ("/evm/1", "/solana/mainnet"), NOT an absolute URL.
  // Resolved against RPC_PROXY_URL on read by
  // src/blockchains/rpc-endpoint.ts, so the proxy origin and its bearer token
  // stay in env: rotating either is a redeploy, never a re-seed, and no
  // upstream provider credential is stored here or served from the @Public()
  // GET /blockchains response. Absolute URLs are still honoured (passed
  // through unauthenticated) for rows predating the proxy cutover.
  rpcUrl            String
  blockExplorer     String
  // Chain family — "EVM" | "SVM" | "MOVE_VM" | "STELLAR" (see
  // src/blockchains/chain-family.ts for the validated TS union). Deliberately
  // a plain string, not a Postgres enum: adding a new chain to an existing
  // family needs zero migration, and a genuinely new family only needs a
  // one-line addition to CHAIN_FAMILIES + a data backfill, not a schema
  // change. assertChainFamily() enforces this at every read site instead of
  // at the DB layer — see that file's doc comment for the tradeoff.
  type              String
  isActive          Boolean            @default(true)
  tokens            Token[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  SmartContract     SmartContract[]
  isTestnet         Boolean            @default(false)
  pointTransactions PointTransaction[]
  nftAssets         NftAsset[]

  // Onchain settlement coordinates (Phase 1). `takumiWalletContract` was
  // removed — it was NULL on every row (never actually populated by ops or
  // seed) and duplicated the same address already tracked as a
  // SmartContract row (name: "takumi_pay"), same pattern as Solana/Stellar.
  quoteSignerAddress String?
  minConfirmations   Int?

  // Circle Gateway / Paymaster contract addresses live in `SmartContract`
  // (name: "gateway_wallet" / "gateway_minter" / "paymaster"), not scalar
  // columns here — they were previously duplicated: `gatewayWalletContract`
  // and `x402VerifyingContract` held the identical address on Arc (Circle's
  // Gateway wallet contract *is* the x402 EIP-712 verifying contract by
  // protocol design, not a coincidence), with no sync guarantee between the
  // two columns. `x402VerifyingContract` resolves from the "gateway_wallet"
  // SmartContract row unless a chain seeds a distinct "x402_verifying" row
  // (see blockchain-enricher.ts#buildX402) — future-proofing for a chain
  // where they genuinely differ, without re-introducing the duplication for
  // the common case.
  //
  // x402DomainName / x402DomainVersion / x402FacilitatorUrl (genuine
  // per-chain config, not addresses) live in `metadata` below. Nullable —
  // Gateway is not deployed on every chain, and Arc itself has no Paymaster
  // (USDC=gas).
  metadata Json?

  // ERC-4337 bundler URL (task 37 — `POST /v1/userop/submit`). Currently
  // carries the provider API key in the query string (`?apikey=…`). This
  // column is SERVER-ONLY — must never be serialized through the public
  // `GET /v1/blockchains` endpoint (task 21). See
  // `docs/security_review_needed.md §4` for the planned migration to split
  // the URL from the key and move the key to a secrets manager.
  bundlerUrl String?

  // Solana-specific fields (Solana contract integration)
  solanaCluster String?

  // NOTE: on Stellar rows, `rpcUrl` routes to the Soroban RPC endpoint (what
  // this API actually calls for contract reads/simulation) — not Horizon.
  // Which upstream `/stellar/<network>` resolves to is rpc-proxy's decision
  // now (see rpc-proxy/src/db/seed.ts), not this column's.
  // A prior version of this model had a separate `stellarSorobanRpcUrl`
  // column reasoned from "the mobile wallet already expects `rpcUrl` to be
  // Horizon" (mobile-app/docs/stellar-chain-support-spec.md §3.8); removed
  // by deliberate choice to keep one endpoint column per chain like every
  // other chain here, accepting that mobile's Horizon connectivity is a
  // separate, not-yet-reconciled concern in a different repo.

  // NOTE: the takumi_pay program/contract address for Solana and Stellar is
  // NOT stored here — it lives in `SmartContract` (name: "takumi_pay"),
  // the same per-chain contract registry EVM already uses. A dedicated
  // scalar column here would just duplicate that row (this is exactly what
  // happened before this comment was written: `takumiPayProgramId` on this
  // model and a `SmartContract` row held the same Solana address with no
  // sync guarantee — removed in favor of a single source of truth).
}

model Token {
  id                 String                 @id @default(ulid())
  name               String
  symbol             String
  decimals           Int
  blockchain         Blockchain             @relation(fields: [blockchainId], references: [id])
  blockchainId       String
  contractAddress    String?
  logoUrl            String?
  isStablecoin       Boolean                @default(false)
  isActive           Boolean                @default(true)
  isNativeCurrency   Boolean                @default(false)
  peggedCurrency     String?
  transactions       TransactionHistory[]
  regionAvailability RegionAvailableToken[]
  pointTransactions  PointTransaction[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  // Onchain settlement (Phase 1)
  isPaymentEnabled Boolean @default(false)
  platformFeeBps   Int     @default(0)

  paymentIntents PaymentIntent[]

  @@unique([blockchainId, contractAddress])
}

model ProductPrice {
  id               String            @id @default(ulid())
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id])
  productVariantId String
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  vendorId         String
  realValue        Decimal
  priceFromVendor  Decimal
  sellPrice        Decimal
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  BookingOrder     BookingOrder[]
  pointRedemptions PointRedemption[]
  flashSales       FlashSale[]
  currency         String

  @@index([productVariantId])
  @@index([vendorId])
  @@index([productVariantId, vendorId, isActive])
}

// TimescaleDB Hypertable - optimized for millions of transactions
// Composite PK required for hypertable partitioning on createdAt
// Note: No FK relation to Purchase — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model TransactionHistory {
  id               String            @default(ulid())
  user             User              @relation(fields: [userId], references: [id])
  userId           String
  token            Token             @relation(fields: [tokenId], references: [id])
  tokenId          String
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  amount           Decimal
  amountInFiat     Decimal?
  fiatCurrency     String?
  txHash           String?
  senderAddress    String?
  recipientAddress String?
  merchantName     String?
  paymentIntentId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@id([id, createdAt])
  @@unique([id, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([txHash])
  @@index([paymentIntentId])
}

// Note: transactionId/transactionCreatedAt reference the TransactionHistory
// hypertable but have no DB-level FK — TimescaleDB hypertables cannot be FK targets.
// Referential integrity is enforced at the application level.
model Purchase {
  id                   String         @id @default(ulid())
  transactionId        String
  transactionCreatedAt DateTime
  productVariant       ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId     String
  bookingOrder         BookingOrder   @relation(fields: [bookingOrderId], references: [id])
  bookingOrderId       String         @unique
  status               PurchaseStatus @default(PENDING)
  vendorResponse       Json?
  vendorStatusResponse Json?
  vendorRefId          String?
  refId                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // ── Fulfilment leg (see src/fulfilment). `status` above is the money
  // leg; these track whether the vendor actually handed the product over.
  fulfilmentStatus       FulfilmentStatus  @default(QUEUED)
  fulfilmentError        String?
  /// Structured `DeliveryPayload` (src/delivery) built from `deliveryRaw`.
  delivery               Json?
  /// Vendor's `voucher_code` verbatim — re-parsed by the backfill script
  /// whenever a parser is added or fixed.
  deliveryRaw            String?
  expectedBy             DateTime?
  fulfilledAt            DateTime?
  vendorLastCheckedAt    DateTime?
  vendorCheckCount       Int               @default(0)
  /// Set when the vendor reported delivery AFTER points were refunded —
  /// the clawback queue for ops.
  deliveredAfterRefundAt DateTime?
  refund                 FulfilmentRefund?

  @@unique([transactionId, transactionCreatedAt])
  @@index([refId])
  @@index([fulfilmentStatus, updatedAt])
}

// TimescaleDB Hypertable - already configured with 1-day chunk intervals
model ExchangeRate {
  id               Int            @default(autoincrement())
  fromCurrency     String
  toCurrency       String
  rate             Decimal
  sourceProvider   ExchangeSource @relation(fields: [sourceProviderId], references: [id])
  sourceProviderId String
  region           String?
  provider         String?
  markup           Decimal?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@id([id, createdAt])
  @@unique([fromCurrency, toCurrency, region, provider, createdAt])
}

model ExchangeSource {
  id             String         @id @default(ulid())
  name           String         @unique
  description    String?
  apiEndpoint    String?
  apiKey         String?
  updateInterval Int            @default(3600)
  priority       Int            @default(1)
  isActive       Boolean        @default(true)
  lastUpdated    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  exchangeRates  ExchangeRate[]
}

model VendorAPI {
  id        String   @id @default(ulid())
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  vendorId  String
  baseUrl   String
  apiKey    String
  apiSecret String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmartContract {
  id           String     @id @default(ulid())
  name         String
  // Category of contract, e.g. "payment" (takumi_pay), "gateway" (Circle
  // Gateway wallet/minter/paymaster), "protocol" (DeFi integrations like
  // Aave/Curve/Lido). Free-text, not an enum — new integrations add new
  // categories without a migration.
  type         String
  version      Int        @default(1)
  blockchain   Blockchain @relation(fields: [blockchainId], references: [id])
  blockchainId String
  address      String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([blockchainId, address])
}

enum TransactionType {
  PAYMENT
  REFUND
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  FAILED
  REFUNDED
  TRANSFERRED
}

enum PurchaseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuthProvider {
  WALLET
  GOOGLE
  APPLE
  EMAIL
  ADMIN_CREDENTIALS
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Region {
  id                String   @id @default(ulid())
  code              String   @unique
  name              String
  currencyCode      String
  isActive          Boolean  @default(true)
  hasKYCRequirement Boolean  @default(false)
  taxRate           Decimal  @default(0)
  supportEmail      String?
  supportPhone      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users           User[]
  availableTokens RegionAvailableToken[]
}

model RegionAvailableToken {
  id                 String   @id @default(ulid())
  region             Region   @relation(fields: [regionId], references: [id])
  regionId           String
  token              Token    @relation(fields: [tokenId], references: [id])
  tokenId            String
  isActive           Boolean  @default(true)
  minAmount          Decimal?
  maxAmount          Decimal?
  processingFee      Decimal  @default(0)
  networkFeeEstimate Decimal?
  isDefault          Boolean  @default(false)
  regulatoryNotes    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([regionId, tokenId])
}

enum BookingStatus {
  PENDING
  EXPIRED
  EXECUTED
  CANCELLED
}

enum ReferenceIdStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReferenceId {
  id        String            @id @default(ulid())
  refId     String            @unique
  status    ReferenceIdStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([refId])
  @@index([status])
}

model BookingOrder {
  id               String         @id @default(ulid())
  walletAddress    String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  productPrice     ProductPrice   @relation(fields: [productPriceId], references: [id])
  productPriceId   String
  customerInfo     Json?
  payment          Json
  exchangeRate     Json
  status           BookingStatus  @default(PENDING)
  expiresAt        DateTime
  purchase         Purchase?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([walletAddress])
  @@index([walletAddress, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

enum ApiKeyType {
  SMART_CONTRACT
  MOBILE_APP
  WEB_APP
  THIRD_PARTY
  INTERNAL
  ADMIN
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
  EXPIRED
}

model ApiKey {
  id          String       @id @default(ulid())
  name        String
  description String?
  keyValue    String       @unique
  type        ApiKeyType
  status      ApiKeyStatus @default(ACTIVE)
  permissions Json?
  rateLimit   Int?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int          @default(0)
